{
  "$id": "urn:proofdrift:schema:1.0.0:drift-finding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "after": {},
    "before": {},
    "drift_class": {
      "enum": [
        "provenance drift",
        "capability drift",
        "policy drift",
        "runtime drift",
        "patch-impact drift",
        "test-proof drift"
      ],
      "minLength": 1,
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "explanation": {
      "minLength": 1,
      "type": "string"
    },
    "finding_id": {
      "minLength": 1,
      "type": "string"
    },
    "fingerprint": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "warn",
        "block"
      ],
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "drift_class",
    "verdict",
    "explanation",
    "evidence_refs",
    "fingerprint"
  ],
  "title": "DriftFinding",
  "type": "object"
}
