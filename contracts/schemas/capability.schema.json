{
  "$id": "https://raw.githubusercontent.com/WahuVN/proofdrift-spec/main/contracts/schemas/capability.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "action_family": {
      "minLength": 1,
      "type": "string"
    },
    "capability_id": {
      "minLength": 1,
      "type": "string"
    },
    "constraints": {
      "additionalProperties": true,
      "type": "object"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "resource_selector": {
      "minLength": 0,
      "type": "string"
    },
    "risk_tags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "source": {
      "enum": [
        "declared",
        "inferred",
        "observed"
      ],
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "action_family",
    "resource_selector",
    "source"
  ],
  "title": "Capability",
  "type": "object"
}
