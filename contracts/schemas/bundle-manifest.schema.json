{
  "$id": "urn:proofdrift:schema:1.0.0:bundle-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "attestation_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "bundle_version": {
      "minLength": 1,
      "type": "string"
    },
    "canonicalization": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "entries": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)"
            },
            "pattern": "^[^/\\\\:]+(?:/[^/\\\\:]+)*$",
            "type": "string"
          },
          "sha256": {
            "minLength": 1,
            "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "maximum": 268435456,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "maxItems": 10000,
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "bundle_version",
    "session_id",
    "created_at",
    "canonicalization",
    "entries"
  ],
  "title": "BundleManifest",
  "type": "object"
}
