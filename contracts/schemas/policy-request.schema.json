{
  "$id": "urn:proofdrift:schema:1.0.0:policy-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "action": {
      "minLength": 1,
      "type": "string"
    },
    "capability": {
      "$ref": "urn:proofdrift:schema:1.0.0:capability"
    },
    "context": {
      "additionalProperties": true,
      "type": "object"
    },
    "principal": {
      "minLength": 1,
      "type": "string"
    },
    "provenance": {
      "$ref": "urn:proofdrift:schema:1.0.0:artifact-identity"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "resource": {
      "minLength": 0,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "session_path_summary": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "principal",
    "action",
    "resource"
  ],
  "title": "PolicyRequest",
  "type": "object"
}
