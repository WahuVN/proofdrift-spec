{
  "$id": "https://raw.githubusercontent.com/WahuVN/proofdrift-spec/main/contracts/schemas/policy-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "action": {
      "minLength": 1,
      "type": "string"
    },
    "capability": {
      "$ref": "https://raw.githubusercontent.com/WahuVN/proofdrift-spec/main/contracts/schemas/capability.schema.json"
    },
    "context": {
      "additionalProperties": true,
      "type": "object"
    },
    "principal": {
      "minLength": 1,
      "type": "string"
    },
    "provenance": {
      "$ref": "https://raw.githubusercontent.com/WahuVN/proofdrift-spec/main/contracts/schemas/artifact-identity.schema.json"
    },
    "request_id": {
      "minLength": 1,
      "type": "string"
    },
    "resource": {
      "minLength": 0,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "session_path_summary": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "principal",
    "action",
    "resource"
  ],
  "title": "PolicyRequest",
  "type": "object"
}
