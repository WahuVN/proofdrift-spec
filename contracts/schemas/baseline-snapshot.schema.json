{
  "$id": "urn:proofdrift:schema:1.0.0:baseline-snapshot",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "urn:proofdrift:schema:1.0.0:artifact-identity"
      },
      "type": "array"
    },
    "capabilities": {
      "items": {
        "$ref": "urn:proofdrift:schema:1.0.0:capability"
      },
      "type": "array"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "enforcement_coverage": {
      "additionalProperties": {
        "enum": [
          "L0",
          "L1",
          "L2",
          "L3"
        ],
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "policy_digest": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "name",
    "created_at"
  ],
  "title": "BaselineSnapshot",
  "type": "object"
}
