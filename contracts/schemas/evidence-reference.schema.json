{
  "$id": "urn:proofdrift:schema:1.0.0:evidence-reference",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "digest": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "artifact",
        "event",
        "policy",
        "test",
        "runtime",
        "external"
      ],
      "minLength": 1,
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "type": "string"
    },
    "ref_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "uri": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "ref_id",
    "kind",
    "uri",
    "digest"
  ],
  "title": "EvidenceReference",
  "type": "object"
}
