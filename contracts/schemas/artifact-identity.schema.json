{
  "$id": "urn:proofdrift:schema:1.0.0:artifact-identity",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_type": {
      "enum": [
        "repo",
        "commit",
        "file",
        "skill",
        "hook",
        "agent",
        "plugin",
        "mcp_server",
        "model",
        "dataset",
        "binary",
        "container",
        "package",
        "other"
      ],
      "minLength": 1,
      "type": "string"
    },
    "content_digest": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "local_path": {
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "provenance_status": {
      "enum": [
        "verified",
        "declared",
        "inferred",
        "unknown"
      ],
      "minLength": 1,
      "type": "string"
    },
    "resolved_revision": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "source_uri": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "name",
    "provenance_status"
  ],
  "title": "ArtifactIdentity",
  "type": "object"
}
