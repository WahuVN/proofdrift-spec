{
  "$id": "urn:proofdrift:schema:1.0.0:evaluation-decision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "minLength": 0,
        "type": "string"
      },
      "type": "array"
    },
    "digest": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "findings": {
      "items": {
        "$ref": "urn:proofdrift:schema:1.0.0:drift-finding"
      },
      "type": "array"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "subject": {
      "minLength": 1,
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "warn",
        "block"
      ],
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "subject",
    "verdict",
    "findings",
    "evidence_refs",
    "digest"
  ],
  "title": "EvaluationDecision",
  "type": "object"
}
