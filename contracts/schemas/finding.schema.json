{
  "$id": "urn:proofdrift:schema:1.0.0:finding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "category": {
      "minLength": 1,
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "explanation": {
      "minLength": 1,
      "type": "string"
    },
    "finding_id": {
      "minLength": 1,
      "type": "string"
    },
    "fingerprint": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "location": {},
    "remediation": {
      "minLength": 1,
      "type": "string"
    },
    "rule_id": {
      "minLength": 1,
      "type": "string"
    },
    "rule_version": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "minLength": 1,
      "type": "string"
    },
    "status": {
      "enum": [
        "new",
        "accepted",
        "fixed",
        "suppressed"
      ],
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "rule_id",
    "rule_version",
    "category",
    "severity",
    "title",
    "explanation",
    "remediation",
    "fingerprint",
    "status"
  ],
  "title": "Finding",
  "type": "object"
}
