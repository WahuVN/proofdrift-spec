{
  "$id": "https://raw.githubusercontent.com/WahuVN/proofdrift-spec/main/contracts/schemas/test-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_hashes": {
      "additionalProperties": {
        "minLength": 1,
        "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "changed_code_mapping": {
      "additionalProperties": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "claimed_result": {
      "minLength": 1,
      "type": "string"
    },
    "command": {
      "minLength": 1,
      "type": "string"
    },
    "coverage_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "duration_ms": {
      "minimum": 0,
      "type": "integer"
    },
    "environment_fingerprint": {
      "minLength": 1,
      "pattern": "^(?:sha256:)?[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "exit_status": {
      "type": "integer"
    },
    "observed": {
      "type": "boolean"
    },
    "schema_version": {
      "minLength": 1,
      "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "suites": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "test_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "tool": {
      "minLength": 1,
      "type": "string"
    },
    "tool_version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "command",
    "tool",
    "exit_status",
    "duration_ms",
    "environment_fingerprint",
    "observed"
  ],
  "title": "TestEvidence",
  "type": "object"
}
